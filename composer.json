{
    "name": "tarohida/php-todo-ddd",
    "description": "php todo web application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Taro Hida",
            "email": "sk8trou@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "robmorgan/phinx": "^0.16.12",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "guzzlehttp/guzzle": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "vendor/bin/phpunit --testsuite Unit",
        "test:integration": [
            "php scripts/prepare-test-database.php",
            "vendor/bin/phinx migrate -e testing",
            "vendor/bin/phpunit --testsuite Integration --exclude-group exclusive-database"
        ],
        "test:integration:exclusive-database": "vendor/bin/phpunit --testsuite Integration --group exclusive-database",
        "phinx_create_table": "vendor/bin/phinx create CreateTaskTable",
        "fix_owner": "chown -R 1000.1000 ./db",
        "migrate": "vendor/bin/phinx migrate",
        "rollback": "vendor/bin/phinx rollback"
    }
}
